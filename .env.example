# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  Synod — Environment Configuration Example                                  ║
# ║                                                                            ║
# ║  WHICH FILE TO USE:                                                        ║
# ║  ─────────────────                                                         ║
# ║  • Local development  →  .env          (gitignored, loaded automatically)  ║
# ║  • Production         →  Set via Platform Dashboard (e.g. Vercel)          ║
# ║                                                                            ║
# ║  SETUP:                                                                    ║
# ║  ──────                                                                    ║
# ║  1. Copy this file:   cp .env.example .env                                 ║
# ║  2. Fill in the values below.                                              ║
# ║  3. NEVER commit the active .env file — it is gitignored.                  ║
# ║                                                                            ║
# ║  NEXT.JS CONVENTION:                                                       ║
# ║  ───────────────────                                                       ║
# ║  Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.          ║
# ║  All other variables are server-side only (agent, scripts, contract).      ║
# ╚══════════════════════════════════════════════════════════════════════════════╝


# ════════════════════════════════════════════════════════════════════════════════
#  ACTIVE — read by the running code. The local demo needs only these.
# ════════════════════════════════════════════════════════════════════════════════

# ┌──────────────────────────────────────────────────────────────────────────────┐
# │  Server and Port Configuration                                               │
# └──────────────────────────────────────────────────────────────────────────────┘

# Gateway PORT for Node/TS Coordinator Agent
# Read by: ui     →  ui/src/lib/wasm-env.js:49 (falls back to 3000)
# Note: Can be changed to e.g. 3009 to avoid conflicts during local E2E runs.
PORT=3000


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │  CLI & Coordinator Communications                                            │
# └──────────────────────────────────────────────────────────────────────────────┘

# Coordinator service base URL used by the CLI tool.
# Read by: cli    →  cli/index.js:128, :205 (falls back to http://localhost:3000)
SYNOD_COORDINATOR_URL=http://localhost:3000


# ════════════════════════════════════════════════════════════════════════════════
#  RESERVED — present for the intended production wiring, but NOT read by any code
#  today. (synod has no coordinator agent; the UI hardcodes its defaults and the
#  executor pubkey, so setting these has no effect on the local demo.) Kept commented.
# ════════════════════════════════════════════════════════════════════════════════

# Base URL for the TEE Coordinator service. Not read by code (UI uses its default).
# NEXT_PUBLIC_COORDINATOR_URL=http://localhost:3000

# Mock TEE session key for dashboard requests. Not read by code.
# NEXT_PUBLIC_SESSION_KEY=synod_session_token_sec_key_42

# Enclave secp256k1 public key for ECIES (65-byte uncompressed, starts with 04).
# Not read from env today — the client uses a hardcoded executor pubkey.
# NEXT_PUBLIC_EXECUTOR_PUBKEY=041dfac7ef6d7c24315e526f86e1e022da238bd09cdf3a797956601ac56c643cc035550b63700b7fb8d756365dcfb91910012e5681ceb7b46587a28a7b5b79d207

# Terminal 3 API key — production server-side auth. Not read by local code.
# ⚠️  Real secret in production; never commit a live key.
# T3N_API_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Terminal 3 Tenant DID (did:t3n:<40-char hex>). Not read by local code.
# DID=did:t3n:0123456789abcdef0123456789abcdef01234567

# Same DID exposed to the browser. Not read by local code.
# NEXT_PUBLIC_T3N_DID=did:t3n:0123456789abcdef0123456789abcdef01234567
